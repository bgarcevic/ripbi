/// The live fact table; every dead chain hangs off it.
table Sales
	lineageTag: 11111111-1111-1111-1111-111111111111

	/// Live: the card projects it. Its DAX keeps [Amount] and the YTD item alive.
	measure 'Total Revenue' = CALCULATE(SUM('Sales'[Amount]), 'Time Intelligence'[YTD])
		formatString: "$"#,0
		lineageTag: 22222222-2222-2222-2222-222222222222

	/// Dead: bound by no visual and named by no other expression.
	measure 'Legacy Total' = SUM('Sales'[Old Amount])
		lineageTag: 33333333-3333-3333-3333-333333333333

	/// Dead; its qualified reference names a table that does not exist.
	measure 'Ghost Ref' = SUM('Ghost'[X])
		lineageTag: 44444444-4444-4444-4444-444444444444

	column Amount
		dataType: double
		summarizeBy: sum
		sourceColumn: Amount
		lineageTag: 55555555-5555-5555-5555-555555555555

	column 'Old Amount'
		dataType: double
		summarizeBy: sum
		sourceColumn: Old Amount
		lineageTag: 66666666-6666-6666-6666-666666666666

	column Status
		dataType: string
		sourceColumn: Status
		lineageTag: 77777777-7777-7777-7777-777777777777

	column Region
		dataType: string
		sourceColumn: Region
		lineageTag: 88888888-8888-8888-8888-888888888888

	column Key
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Key
		lineageTag: 99999999-9999-9999-9999-999999999999

	/// Dead calculated column over a live column.
	column Flag = IF('Sales'[Amount] > 10, 1, 0)
		dataType: int64
		lineageTag: aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa

	column 'Month Name'
		dataType: string
		sortByColumn: 'Month Num'
		sourceColumn: Month Name
		lineageTag: bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbb01

	column 'Month Num'
		dataType: int64
		sourceColumn: Month Num
		lineageTag: bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbb02

	partition Sales = m
		mode: import
		source =
				let
				    Source = Sql.Database(ServerName, "db"),
				    Sales_Table = Source{[Item="Sales",Kind="Table"]}[Data]
				in
				    Sales_Table

annotation PBI_ResultType = Table
