/// Its hierarchy and level columns are dead, but the table itself stays
/// alive: the live YTD calculation item's stale `'Date'[Date]` reference
/// keeps the qualifying table alive.
table Date
	lineageTag: dddddddd-dddd-dddd-dddd-dddddddddd01

	column Year
		dataType: int64
		sourceColumn: Year
		lineageTag: dddddddd-dddd-dddd-dddd-dddddddddd02

	column Month
		dataType: int64
		sourceColumn: Month
		lineageTag: dddddddd-dddd-dddd-dddd-dddddddddd03

	/// Live only through the calendar — the engine binds it with the table.
	column Day
		dataType: int64
		sourceColumn: Day
		lineageTag: f0000000-0000-0000-0000-000000000003

	hierarchy Calendar
		lineageTag: dddddddd-dddd-dddd-dddd-dddddddddd04

		level Year
			column: Year
			lineageTag: dddddddd-dddd-dddd-dddd-dddddddddd05

		level Month
			column: Month

	/// The date-table calendar (engine shape verified via tomix-cli). It binds
	/// only [Day] so the dead hierarchy chain above is untouched.
	calendar 'Fiscal Calendar'
		calendarColumnGroup
			column: Day

	partition Date = m
		mode: import
		source =
				let
				    Source = #table({"Year", "Month"}, {})
				in
				    Source
