model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Fact Events","Dim Lookup","Staging Events"]

ref table 'Fact Events'
ref table 'Dim Lookup'
ref table 'Staging Events'

ref cultureInfo en-US
