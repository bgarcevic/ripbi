/// The incremental-refresh parameters. Named by the policy's sourceExpression
/// alone — the Desktop partition below is the unfiltered "Full DataView" — so
/// the policy's source expression is what keeps them alive.
expression RangeStart = #datetime(2024, 1, 1, 0, 0, 0) meta [IsParameterQuery=true, Type="Date Time", IsParameterQueryRequired=true]

expression RangeEnd = #datetime(2024, 12, 31, 0, 0, 0) meta [IsParameterQuery=true, Type="Date Time", IsParameterQueryRequired=true]
