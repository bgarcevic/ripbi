          {
            "name": "Growth %",
            "description": "Growth versus prior year, written across two lines.",
            "expression": "VAR prior = CALCULATE([Sales], DATEADD(\u0027Date\u0027[Date], -1, YEAR))\nRETURN DIVIDE([Sales] - prior, prior)",
            "isHidden": true,
            "kpi": {
              "targetExpression": "[Sales Budget]",
              "statusGraphic": "Three Traffic Lights",
              "statusExpression": "IF([Sales] \u003E [Sales Budget], 1, -1)",
              "trendExpression": "[Sales] - [Sales Budget]"
