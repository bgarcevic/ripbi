{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "V2",
  "position": {
    "x": 450,
    "y": 80,
    "z": 0,
    "height": 400,
    "width": 600,
    "tabOrder": 20
  },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Axis": {
          "projections": [
            {
              "field": {
                "HierarchyLevel": {
                  "Expression": {
                    "Hierarchy": {
                      "Expression": {
                        "PropertyVariationSource": {
                          "Expression": {
                            "SourceRef": {
                              "Entity": "Sales"
                            }
                          },
                          "Name": "Variation",
                          "Property": "Date"
                        }
                      },
                      "Hierarchy": "Date Hierarchy"
                    }
                  },
                  "Level": "Year"
                }
              },
              "queryRef": "Sales.Date Hierarchy.Year",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Sales"
                    }
                  },
                  "Property": "Total"
                }
              },
              "queryRef": "Sales.Total",
              "active": true
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
