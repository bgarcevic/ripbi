	partition LocalDateTable_00000000-0000-0000-0000-000000000001 = calculated
		mode: import
		source = Calendar(Date(Year(MIN('Sales'[Date])), 1, 1), Date(Year(MAX('Sales'[Date])), 12, 31))

	annotation __PBI_LocalDateTable = true
