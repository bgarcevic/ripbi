model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Product","Sales","Date","Geo","Sentiment","Manufacturer","Indicators","Category"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table Product
ref table Sales
ref table Date
ref table Geo
ref table Sentiment
ref table Manufacturer
ref table Indicators
ref table Category
ref table Calculations

ref cultureInfo en-US

