			column 'Weeks Open' =
					
					ABS (
					    DATEDIFF (
					        Opportunities[Opportunity Created On],
					        IF (
					            ISBLANK ( Opportunities[CloseDate] ) = TRUE (),
					            TODAY (),
					            Opportunities[CloseDate]
					        ),
					        WEEK
					    )
					)
				formatString: #,0
				lineageTag: 306e46c3-251b-4fb0-852e-2a4a1fe836e8
