createOrReplace

	model Model
		culture: en-US
		defaultPowerBIDataSourceVersion: powerBI_V3
		sourceQueryCulture: en-US
		dataAccessOptions
			legacyRedirects
			returnErrorValuesAsNull

		/// The business units the company organizes work around. Lets reports break the workforce down by market, region, and the VP who owns it.
		table 'Business unit'
			lineageTag: b0e8fd57-87f1-48ee-b325-bc99770c8833

			/// Name of the business unit / market.
			column BU
				dataType: string
				isHidden
				lineageTag: 06acea7b-1a5c-4b04-a6e5-d6cfb3875cf8
				summarizeBy: none
				sourceColumn: BU

				changedProperty = IsHidden

				annotation SummarizationSetBy = Automatic

			/// Region label with a leading sort code so regions appear in a chosen order rather than alphabetically.
			column 'Region with order'
				dataType: string
				isHidden
				lineageTag: cb33be0a-af4e-4cf3-903c-8b0a6b1d39c8
				summarizeBy: none
				sourceColumn: Region with order

				changedProperty = IsHidden

				annotation SummarizationSetBy = Automatic

			/// VP (Market Director) who owns the business unit.
			column VP
				dataType: string
				lineageTag: 95aed9fa-d65f-4922-918b-00ba44d387d4
				summarizeBy: none
				sourceColumn: VP

				annotation SummarizationSetBy = Automatic

			/// Region the business unit belongs to (Americas, EMEA, APAC, ...).
			column Region = mid([Region with order], 3,15)
				lineageTag: efdd656d-19d2-47a1-81b1-d7c47ef78b7f
				summarizeBy: none
				sortByColumn: 'Region with order'

				annotation SummarizationSetBy = Automatic

			partition 'Business unit' = m
				mode: import
				source =
						let
						    Source = Sql.Database(".", "IP", [Query="select distinct market BU,#(lf)  REGIONTITLE Region,#(lf)  MARKETDIRECTOR VP#(lf)from hr.bu"]),
						    #"Renamed Columns" = Table.RenameColumns(Source, {{"BU", "BU"}, {"Region", "RegionSeq"}, {"VP", "VP"}}),
						    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns", {{"BU", type text}, {"RegionSeq", type text}, {"VP", type text}}),
						    #"Renamed Columns1" = Table.RenameColumns(#"Changed Type",{{"RegionSeq", "Region with order"}})
						in
						    #"Renamed Columns1"

			changedProperty = Name

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Exception

		/// Whether an employee is Full-Time or Part-Time. Lets reports compare workforce and hiring trends by employment status.
		table 'Employee type'
			lineageTag: 2abe1b74-5b40-4ff6-bdf2-5ffae70039ee

			/// Employee type code.
			column 'Employee type ID'
				dataType: string
				isHidden
				lineageTag: 285f005e-893b-4160-b3a5-e5f12906c30c
				summarizeBy: none
				sourceColumn: Employee type ID

				changedProperty = IsHidden

				annotation SummarizationSetBy = Automatic

			/// Whether the employee is Full-Time or Part-Time.
			column 'Employee type'
				dataType: string
				lineageTag: 5134b507-0a27-4299-8469-af46844d374b
				summarizeBy: none
				sourceColumn: Employee type

				annotation SummarizationSetBy = Automatic

			partition 'Employee type' = m
				mode: import
				source =
						let
						    Source = Sql.Database(".", "IP", [Query="SELECT [HR].[FP].*   FROM [HR].[FP]"]),
						    #"Renamed Columns" = Table.RenameColumns(Source, {{"FP", "FP"}, {"FPDesc", "FPDesc"}}),
						    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns", {{"FP", type text}, {"FPDesc", type text}}),
						    #"Renamed Columns1" = Table.RenameColumns(#"Changed Type",{{"FP", "Employee type ID"}, {"FPDesc", "Employee type"}})
						in
						    #"Renamed Columns1"

			changedProperty = Name

		/// Whether an employee is paid Hourly or Salaried. Lets reports compare workforce and turnover patterns across pay structures.
		table 'Pay type'
			lineageTag: c4c6031b-bd3a-4a72-854f-d8d9adc39500

			/// Pay type code.
			column 'Pay type ID'
				dataType: string
				isHidden
				lineageTag: 8fd518c2-13e5-4b3c-bac0-8b6803ef856c
				summarizeBy: none
				sourceColumn: Pay type ID

				annotation SummarizationSetBy = Automatic

			/// Whether the employee is paid Hourly or Salaried.
			column 'Pay type'
				dataType: string
				lineageTag: 6c2fd68e-2357-4584-b27c-a0567306082d
				summarizeBy: none
				sourceColumn: Pay type

				annotation SummarizationSetBy = Automatic

			partition PayGroup = m
				mode: import
				source =
						let
						    Source = Sql.Database(".", "IP", [Query="select distinct PayTypeID, [Hrly-Salaried] PayType#(lf)from [HR].[PayGroup]"]),
						    #"Renamed Columns" = Table.RenameColumns(Source, {{"PayTypeID", "PayTypeID"}, {"PayType", "PayType"}}),
						    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns", {{"PayTypeID", type text}, {"PayType", type text}}),
						    #"Renamed Columns1" = Table.RenameColumns(#"Changed Type",{{"PayType", "Pay type"}, {"PayTypeID", "Pay type ID"}})
						in
						    #"Renamed Columns1"

			changedProperty = Name

		/// Why someone left the company - voluntary vs. involuntary. Lets reports understand what's driving separations.
		table 'Separation reason'
			lineageTag: 5de7782d-aec5-479c-ab3c-4d7827e6fce3

			/// Separation reason code.
			column 'Separation reason ID'
				dataType: string
				isHidden
				lineageTag: a356f7f1-fb4c-4481-8758-f347246bdcf6
				summarizeBy: none
				sourceColumn: Separation reason ID

				annotation SummarizationSetBy = Automatic

			/// Whether a departure was Voluntary or Involuntary.
			column 'Separation reason'
				dataType: string
				lineageTag: d8f39dbc-5fa7-46ae-bdc9-2c855ac027b5
				summarizeBy: none
				sourceColumn: Separation reason

				annotation SummarizationSetBy = Automatic

			partition TermReason = m
				mode: import
				source =
						let
						    Source = Sql.Database(".", "IP", [Query="SELECT distinct SeparationTypeID, [Vol-Invol] SeparationReason#(lf)  FROM [IP].[HR].[TermReason]"]),
						    #"Renamed Columns" = Table.RenameColumns(Source, {{"SeparationTypeID", "SeparationTypeID"}, {"SeparationReason", "SeparationReason"}}),
						    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns", {{"SeparationTypeID", type text}, {"SeparationReason", type text}}),
						    #"Renamed Columns1" = Table.RenameColumns(#"Changed Type",{{"SeparationReason", "Separation reason"}, {"SeparationTypeID", "Separation reason ID"}})
						in
						    #"Renamed Columns1"

			changedProperty = Name

			annotation PBI_NavigationStepName = Navigation

			annotation PBI_ResultType = Exception

		/// The calendar the model runs on. Enables trending, year-over-year comparisons, and any time-based slicing (year, quarter, month, day).
		table Date
			lineageTag: fcf95b56-e617-491e-893f-00e4597e641c
			dataCategory: Time

			/// The specific calendar day.
			column Date
				dataType: dateTime
				isKey
				formatString: General Date
				lineageTag: ad72503a-626e-4f7f-bf6b-30637a1c5dea
				summarizeBy: none
				sourceColumn: Date

				annotation SummarizationSetBy = Automatic

			/// Month name (Jan, Feb, ...) for grouping and trending.
			column Month
				dataType: string
				lineageTag: 44a9ad95-6530-4678-b989-9749fe691670
				summarizeBy: none
				sourceColumn: Month
				sortByColumn: 'Month number'

				annotation SummarizationSetBy = Automatic

			/// Month of the year as a number (1-12).
			column 'Month number'
				dataType: int64
				lineageTag: 69138651-3695-4545-afd4-a647cb122e7b
				summarizeBy: sum
				sourceColumn: Month number

				annotation SummarizationSetBy = Automatic

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Year and month combined into a reporting period label.
			column Period
				dataType: string
				lineageTag: fa550177-7149-47fa-be77-554d299f042f
				summarizeBy: none
				sourceColumn: Period
				sortByColumn: 'Period number'

				annotation SummarizationSetBy = Automatic

			/// Numeric version of the reporting period, used to keep periods in chronological order.
			column 'Period number'
				dataType: int64
				lineageTag: 8234d3c8-1d33-4df9-8a6a-daaaa459afc2
				summarizeBy: sum
				sourceColumn: Period number

				annotation SummarizationSetBy = Automatic

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Quarter of the year as a number (1-4).
			column Qtr
				dataType: int64
				lineageTag: 1fb80d69-2b87-4e88-97a9-2c3b60e7aace
				summarizeBy: sum
				sourceColumn: Qtr

				annotation SummarizationSetBy = Automatic

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Quarter label (Q1, Q2, ...).
			column QtrNumber
				dataType: string
				lineageTag: 09e4ae29-92ea-42c4-a7d8-97de8dc81e21
				summarizeBy: none
				sourceColumn: QtrNumber

				annotation SummarizationSetBy = Automatic

			/// Calendar year.
			column Year
				dataType: int64
				lineageTag: 56b46769-d33d-4aa8-82f9-9824fd146251
				summarizeBy: sum
				sourceColumn: Year

				annotation SummarizationSetBy = Automatic

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Day of the month.
			column Day
				dataType: int64
				lineageTag: 4fd1f5a8-500e-4603-b019-5e60fb3163ea
				summarizeBy: sum
				sourceColumn: Day

				annotation SummarizationSetBy = Automatic

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// First day of the month a date falls in.
			column 'Month start date'
				dataType: dateTime
				formatString: General Date
				lineageTag: b406a759-c35f-4f27-9ae3-c13f61f49d9c
				summarizeBy: none
				sourceColumn: Month start date

				annotation SummarizationSetBy = Automatic

			/// Last day of the month a date falls in.
			column 'Month end date'
				dataType: dateTime
				formatString: General Date
				lineageTag: 94efa1ef-6993-47f0-8e98-adbdb6de4029
				summarizeBy: none
				sourceColumn: Month end date

				annotation SummarizationSetBy = Automatic

			/// Sequential month counter that runs across years - handy for continuous trend lines that shouldn't restart each January.
			column MonthIncrementNumber = ([Year]-MIN([Year]))*12 +[Month number]
				isHidden
				lineageTag: c01f1989-027f-4f34-9698-4efdcc269f00
				summarizeBy: sum

				annotation SummarizationSetBy = Automatic

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			hierarchy YQM
				lineageTag: 2d0ba6c3-0b1b-4cea-93bd-688956e54a7c

				level Year
					lineageTag: 58deddc6-f101-4863-9fe3-151b3d07f5cb
					column: Year

				level QtrNumber
					lineageTag: f4b7f26d-f884-4068-9bef-e6f1d625c3a5
					column: QtrNumber

				level 'Period number'
					lineageTag: c00652af-af6c-42e5-a2a6-d408f7f8cbe8
					column: 'Period number'

			partition Date = m
				mode: import
				source =
						let
						    Source = Sql.Database(".", "IP", [Query="SELECT [HR].[Date].*   FROM [HR].[Date]"]),
						    #"Renamed Columns" = Table.RenameColumns(Source, {{"Date", "Date"}, {"Month", "Month"}, {"MonthNumber", "MonthNumber"}, {"Period", "Period"}, {"PeriodNumber", "PeriodNumber"}, {"Qtr", "Qtr"}, {"QtrNumber", "QtrNumber"}, {"Year", "Year"}, {"Day", "Day"}, {"MonthStartDate", "MonthStartDate"}, {"MonthEndDate", "MonthEndDate"}}),
						    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns", {{"Date", type datetime}, {"Month", type text}, {"MonthNumber", Int64.Type}, {"Period", type text}, {"PeriodNumber", Int64.Type}, {"Qtr", Int64.Type}, {"QtrNumber", type text}, {"Year", Int64.Type}, {"Day", Int64.Type}, {"MonthStartDate", type datetime}, {"MonthEndDate", type datetime}}),
						    #"Renamed Columns1" = Table.RenameColumns(#"Changed Type",{{"MonthEndDate", "Month end date"}, {"MonthNumber", "Month number"}, {"MonthStartDate", "Month start date"}, {"PeriodNumber", "Period number"}})
						in
						    #"Renamed Columns1"

		/// The workforce record that powers this model. It tracks who worked where each month and captures every hire and separation, so the business can answer questions about headcount, turnover, hiring, tenure, and workforce mix over time.
		table Employee
			isHidden
			lineageTag: 63799ae9-1b99-4762-ae04-59d4f66ad037

			/// Total headcount for the period in scope.
			measure Employees = CALCULATE(COUNT([EmplID]), FILTER(ALL('Date'[Period number]), 'Date'[Period number] = MAX('Date'[Period number])))
				formatString: #,0
				lineageTag: 01210a97-c3dc-4030-af85-0df92bea1155

			/// Number of employees who left the company in the period.
			measure Separations = CALCULATE(COUNT([EmplID]), FILTER(Employee, NOT(ISBLANK(Employee[TermDate]))))
				formatString: #,0
				lineageTag: 9cee6ad0-4ed6-4060-9d0a-99e6620b2a36

			/// Number of employees still working at the end of the period.
			measure Actives = CALCULATE([Employees], FILTER(Employee, ISBLANK(Employee[TermDate])))
				formatString: #,0
				lineageTag: 85d7360e-4032-4f77-9e4f-ebb90f83c025

			/// Number of employees hired in the period.
			measure 'New Hires' = SUM([isNewHire])
				formatString: #,0
				lineageTag: 2150a28c-fd38-4cd0-8461-b8529472f84a

			/// Average employee tenure, in days.
			measure 'AVG Tenure Days' = AVERAGE([TenureDays])
				formatString: #,0
				lineageTag: 847843f6-d136-4485-a733-e5d6591ae5cf

			/// Average employee tenure, in months.
			measure 'AVG Tenure Months' = ROUND([AVG Tenure Days]/30, 1)-1
				formatString: 0
				lineageTag: 6dba930b-1a70-4cbe-b4e6-1068100e9f78

			/// Average employee age.
			measure 'AVG Age' = ROUND(AVERAGE([Age]), 0)
				lineageTag: 04f0331c-57d6-4523-af61-5612ecf2ed20

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Number of new hires in the same period one year ago - the comparison point for year-over-year hiring.
			measure 'New Hires SPLY' = CALCULATE([New Hires],SAMEPERIODLASTYEAR('Date'[Date]))
				formatString: #,0
				lineageTag: d53f7711-4e53-4bb7-ba5a-8fd82e1404c6

			/// Active headcount in the same period one year ago - the comparison point for year-over-year workforce size.
			measure 'Actives SPLY' = CALCULATE([Actives],SAMEPERIODLASTYEAR('Date'[Date]))
				formatString: #,0
				lineageTag: 84bdbb48-7b97-4285-9774-c747379163f6

			/// Separations in the same period one year ago - the comparison point for year-over-year attrition.
			measure 'Seps SPLY' = CALCULATE([Separations],SAMEPERIODLASTYEAR('Date'[Date]))
				formatString: #,0
				lineageTag: 74a51ca4-495d-49ba-a27c-e74cf32c23db

			/// Total headcount in the same period one year ago.
			measure 'Employees SPLY' = CALCULATE(COUNT([EmplID]), FILTER(ALL('Date'[Period number]), 'Date'[Period number] = MAX('Date'[Period number])),SAMEPERIODLASTYEAR('Date'[Date]))
				formatString: #,0
				lineageTag: 5d72d359-a2ce-4e62-8c82-605f5d8879fb

			/// Change in separations vs. the same period last year (positive = more people leaving).
			measure 'Seps YoY Var' = [Separations]-[Seps SPLY]
				formatString: #,0
				lineageTag: 4e89664a-40aa-412e-b07b-40b99f6f552d

			/// Change in active headcount vs. the same period last year (positive = workforce grew).
			measure 'Actives YoY Var' = [Actives]-[Actives SPLY]
				formatString: #,0
				lineageTag: ac589e5a-1a95-4e42-94ee-0ed615fa540e

			/// Change in new hires vs. the same period last year (positive = more hiring).
			measure 'New Hires YoY Var' = [New Hires]-[New Hires SPLY]
				formatString: #,0
				lineageTag: fd1f1b05-5d56-4bad-81e1-dd49cc74aa84

			/// Percent change in separations vs. the same period last year - shows whether attrition is trending up or down.
			measure 'Seps YoY % Change' = DIVIDE([Seps YoY Var], [Seps SPLY])
				formatString: #,0.0%;-#,0.0%;#,0.0%
				lineageTag: 3a109bb7-2c23-4391-a6ce-20ce978286c3

			/// Percent change in active headcount vs. the same period last year - shows workforce growth or shrinkage.
			measure 'Actives YoY % Change' = DIVIDE([Actives YoY Var], [Actives SPLY])
				formatString: #,0.0%;-#,0.0%;#,0.0%
				lineageTag: de0d73ca-3cfe-4e93-a63b-1a6643c2ed9a

			/// Percent change in new hires vs. the same period last year - shows whether hiring is accelerating or slowing.
			measure 'New Hires YoY % Change' = DIVIDE([New Hires YoY Var], [New Hires SPLY])
				formatString: #,0.0%;-#,0.0%;#,0.0%
				lineageTag: 72d2e96f-621a-43df-8a76-ca8273685080

			/// Bad hires in the same period one year ago - the comparison point for early-attrition trends.
			measure 'Bad Hires SPLY' = CALCULATE([Bad hires],SAMEPERIODLASTYEAR('Date'[Date]))
				formatString: #,0
				lineageTag: 0b1de625-75ec-4294-a714-8f57065c755a

			/// Change in bad hires vs. the same period last year (positive = more people leaving within their first 60 days).
			measure 'Bad Hires YoY Var' = [Bad hires]-[Bad Hires SPLY]
				formatString: #,0
				lineageTag: e9706dd4-704e-4702-b54f-a998cf479e5f

			/// Percent change in bad hires vs. the same period last year - shows whether early-attrition of new hires is getting worse.
			measure 'Bad Hires YoY % Change' = DIVIDE([Bad Hires YoY Var], [Bad Hires SPLY])
				formatString: #,0%;-#,0%;#,0%
				lineageTag: dfb9718f-7919-4d21-b555-602025a508e0

			/// Turnover rate: share of the active workforce that separated in the period.
			measure 'Sep % of Active' = DIVIDE([Separations],[Actives])
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: fbff1435-b8f2-4999-ba10-0c3daa356a0f

			/// Turnover rate for the same period one year ago - the comparison point for [Sep % of Active].
			measure 'Sep % of SMLY Actives' = DIVIDE([Seps SPLY],[Actives SPLY])
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: 8abf85c3-a19f-4e2d-9487-42e34b28e913

			/// Bad-hire rate: share of the active workforce that came in as a bad hire.
			measure 'Bad hires % of actives' = DIVIDE([Bad hires],[Actives])
				formatString: 0%;-0%;0%
				lineageTag: e4c439c2-f503-4c90-a2b4-3e1138baf3dc

			/// Bad-hire rate for the same period one year ago - the comparison point for [Bad hires % of actives].
			measure 'Bad hires % of Active SPLY' = DIVIDE([Bad Hires SPLY],[Actives SPLY])
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: 1fc9db3d-1852-4b1a-8b0f-ae52d85a7f5f

			/// Number of hires who left within 60 days - the standard measure of failed hires.
			measure 'Bad hires' = sum(Employee[BadHires])
				formatString: #,0
				lineageTag: 5d15966c-bc08-419e-9053-9360c16aab7e

			/// The snapshot month this employee record applies to.
			column date
				dataType: dateTime
				isHidden
				formatString: General Date
				lineageTag: b592a58d-3842-4a55-8945-59e53f471cdc
				summarizeBy: none
				sourceColumn: date

				annotation SummarizationSetBy = Automatic

			/// Unique employee identifier.
			column EmplID
				dataType: int64
				isHidden
				lineageTag: 051997eb-138d-40ef-8553-615cfbd581fc
				summarizeBy: count
				sourceColumn: EmplID

				annotation SummarizationSetBy = Automatic

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Employee's gender.
			column Gender
				dataType: string
				isHidden
				lineageTag: 5737742d-f701-48dd-8e2a-e21ce261dbd6
				summarizeBy: none
				sourceColumn: Gender

				annotation SummarizationSetBy = Automatic

			/// Employee's age.
			column Age
				dataType: int64
				isHidden
				lineageTag: 93554c39-0b06-429b-88b2-f50fedf69c07
				summarizeBy: sum
				sourceColumn: Age

				annotation SummarizationSetBy = Automatic

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Employee's ethnicity.
			column EthnicGroup
				dataType: string
				isHidden
				lineageTag: b02fa421-ff80-4cb6-9985-921c0d2a7481
				summarizeBy: none
				sourceColumn: EthnicGroup

				annotation SummarizationSetBy = Automatic

			/// Whether the employee is Full-Time or Part-Time.
			column FP
				dataType: string
				isHidden
				lineageTag: 1d6b87b0-336b-44da-a4ac-70cd56accd30
				summarizeBy: none
				sourceColumn: FP

				annotation SummarizationSetBy = Automatic

			/// Date the employee left the company. Empty if they were still active in the month.
			column TermDate
				dataType: dateTime
				isHidden
				formatString: General Date
				lineageTag: 72be8ca7-8f53-496c-9ba8-a83249e90f06
				summarizeBy: none
				sourceColumn: TermDate

				annotation SummarizationSetBy = Automatic

			/// Flag that marks the row for the month an employee was hired.
			column isNewHire = IF(YEAR([date]) = YEAR([HireDate]) && MONTH([date])=MONTH([HireDate]), 1)
				isHidden
				lineageTag: ba9f7d94-e997-4d30-9273-714e4c123732
				summarizeBy: sum

				annotation SummarizationSetBy = Automatic

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Business unit the employee works in.
			column BU
				dataType: string
				isHidden
				lineageTag: b4fdff84-3fed-44b4-8d9a-d98666fcd583
				summarizeBy: none
				sourceColumn: BU

				annotation SummarizationSetBy = Automatic

			/// Date the employee originally joined the company.
			column HireDate
				dataType: dateTime
				isHidden
				lineageTag: 4859e447-cd4c-4683-9373-43c6da347411
				summarizeBy: none
				sourceColumn: HireDate

				annotation SummarizationSetBy = Automatic

			/// Whether the employee is paid Hourly or Salaried.
			column PayTypeID
				dataType: string
				isHidden
				lineageTag: 2f2f5131-def6-4aac-b3a5-7b238793ec49
				summarizeBy: none
				sourceColumn: PayTypeID

				annotation SummarizationSetBy = Automatic

			/// Reason the employee left the company (only populated for separations).
			column TermReason
				dataType: string
				isHidden
				lineageTag: 5fffba74-245a-4b8d-83c3-b13d6e5a1804
				summarizeBy: none
				sourceColumn: TermReason

				annotation SummarizationSetBy = Automatic

			/// The age band the employee falls into.
			column AgeGroupID = IF([Age]<30, 1, IF([Age]<50, 2, 3))
				isHidden
				lineageTag: 7a1ddc46-6870-4a4f-9e17-8eb3f7cf59d1
				summarizeBy: none

				annotation SummarizationSetBy = Automatic

