/// Key business metrics for tracking sales performance, revenue, and pipeline health.
table Calculations
	lineageTag: f92a72fd-3168-4ba3-be9d-5fe62ca23d1e

	/// Average number of days an opportunity stays active before close.
	measure 'Avg Opportunity Days' = AVERAGE([Opportunity Days])
		formatString: #,0
		lineageTag: 9bfae785-435c-4e03-88be-8d4d3a8df8df

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average revenue per opportunity in the current filter context.
	measure 'Avg Revenue' = AVERAGE([ProductRevenue])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 5ca57a64-b692-4631-bbf4-2b8094913054

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Revenue weighted by the sales-stage win probability — a probability-adjusted view of pipeline value.
	measure 'Factored Revenue' = SUM([FactoredProductRevenue])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: fe06ee4a-608e-4dce-88e7-0167877c91d7

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Number of opportunities in the current filter context.
	measure 'Opportunity Count' = COUNTA('Calculations'[Opportunity ID])
		formatString: 0
		lineageTag: d1fc1df6-dcf2-4676-870b-cf30b11e4c7a

	/// Total product revenue (unweighted) across selected opportunities.
	measure Revenue = SUM('Calculations'[ProductRevenue])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 376639e5-fb0e-42f5-a83c-d60247748851

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Total number of days opportunities have been active (sum of Opportunity Days).
	measure 'Total opportunity days' = sum([Opportunity Days])
		formatString: #,0
		lineageTag: ec13dffd-ce47-4213-adb3-1c18c1b5b118

	/// Estimated date the opportunity is expected to close.
	column EstimatedCloseDate
		dataType: dateTime
		isHidden
		formatString: General Date
		lineageTag: 09775b4d-acf2-46d1-89d6-a8e4e95c2916
		summarizeBy: none
		sourceColumn: EstimatedCloseDate

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

